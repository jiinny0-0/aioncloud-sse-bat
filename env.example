# .env로 복사해서 채웁니다. .env는 git에 올라가지 않고 리포트에도 기록되지 않습니다.
# 스테이지마다 자격증명이 다르면 config/environments.yaml의 그 스테이지 env_file:에
# 적은 이름(예: .env.qa)으로 복사합니다. 공용 .env보다 먼저 읽힙니다.

# 콘솔 로그인 계정 (모든 BAT 워크스페이스에 공통)
BAT_CONSOLE_USER=
BAT_CONSOLE_PASSWORD=

# 콘솔에서 발급한 Open API 토큰 (/sia/v1/** 호출용)
BAT_OPENAPI_TOKEN=
# 워크스페이스별 토큰이 있으면 그 값이 우선
# BAT_OPENAPI_TOKEN_SBATEST1=
# BAT_OPENAPI_TOKEN_SBATEST2=

# 테스트 단말 WinRM 계정 (transport: local이면 생략)
BAT_ENDPOINT_USER=
BAT_ENDPOINT_PASSWORD=

# config/environments.yaml의 스테이지 블록 이름
BAT_PROFILE=qa

# 실행 한 번에 makeOpenAPIToken을 호출할 수 있는 최대 횟수
BAT_TOKEN_BUDGET=10

# 대기 시간(초)
BAT_EVENT_TIMEOUT_SEC=30
BAT_POLICY_TIMEOUT_SEC=20
